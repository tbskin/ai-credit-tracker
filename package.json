{
  "name": "credit-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted dashboard for AI wallets and cloud usage.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run test:e2e",
    "format": "prettier --write src public extension tests *.js *.json *.md .github"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "prettier": "^3.8.1"
  }
}

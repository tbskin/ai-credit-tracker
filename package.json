{
  "name": "stash-credit-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted remaining-credit tracker with local browser sessions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run test:e2e",
    "format": "prettier --write src public tests scripts *.js *.json *.md .github",
    "prebrowser:install": "node scripts/check-runtime.js",
    "browser:install": "playwright install chromium && npm run browser:check",
    "browser:check": "node scripts/check-browser.js"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "playwright": "1.58.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "prettier": "^3.8.1"
  }
}
